generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id          String   @id @default(uuid())
  name        String   @unique
  basePrice   Decimal  @db.Decimal(10, 2)
  maxTables   Int      @default(10)
  maxScreens  Int      @default(5)
  maxStaff    Int      @default(10)
  maxLocations Int     @default(1)
  features    Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions Subscription[]

  @@index([isActive])
}

model Subscription {
  id            String             @id @default(uuid())
  restaurantId  String             @unique
  planId        String
  status        SubscriptionStatus @default(TRIAL)
  trialUntil    DateTime?
  paidUntil     DateTime?
  cancelledAt   DateTime?
  maxScreens    Int?
  maxTables     Int?
  maxStaff      Int?
  maxLocations  Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan          Plan               @relation(fields: [planId], references: [id])

  @@index([restaurantId])
  @@index([planId])
  @@index([status])
}

model Device {
  id           String      @id @default(uuid())
  restaurantId String
  deviceId     String      @unique
  deviceType   DeviceType
  name         String?
  lastSeenAt   DateTime?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([deviceId])
  @@index([isActive])
}

model Restaurant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  address       String?
  phone         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  subscription  Subscription?
  categories    Category[]
  customers     Customer[]
  KitchenTicket KitchenTicket[]
  ModifierGroup ModifierGroup[]
  orders        Order[]
  Payment       Payment[]
  products      Product[]
  Refund        Refund[]
  shifts        Shift[]
  tables        Table[]
  TableArea     TableArea[]
  users         User[]
  devices       Device[]
  Ingredient    Ingredient[]
  Recipe        Recipe[]
  StockAdjustment StockAdjustment[]
  GiftCard      GiftCard[]
  MarketingCampaign MarketingCampaign[]
  Reservation   Reservation[]
  WaitlistEntry WaitlistEntry[]
  AuditLog      AuditLog[]
}

model User {
  id           String     @id @default(uuid())
  restaurantId String?
  fullName     String
  pin          String?
  email        String?    @unique
  passwordHash String?
  role         UserRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  Payment      Payment[]
  Refund       Refund[]
  shifts       Shift[]
  Table        Table[]
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([restaurantId, role])
  @@index([email])
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Product {
  id                   String                 @id @default(uuid())
  restaurantId         String
  categoryId           String
  name                 String
  description          String?
  price                Decimal                @db.Decimal(10, 2)
  sku                  String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  imageUrl             String?
  orderItems           OrderItem[]
  category             Category               @relation(fields: [categoryId], references: [id])
  restaurant           Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ProductModifierGroup ProductModifierGroup[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([categoryId])
}

model ModifierGroup {
  id                   String                 @id @default(uuid())
  restaurantId         String
  name                 String
  selectionType        ModifierSelectionType  @default(SINGLE)
  isRequired           Boolean                @default(false)
  minSelect            Int                    @default(0)
  maxSelect            Int?
  sortOrder            Int                    @default(0)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  Restaurant           Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options              ModifierOption[]
  ProductModifierGroup ProductModifierGroup[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model ModifierOption {
  id              String              @id @default(uuid())
  modifierGroupId String
  name            String
  priceDelta      Decimal             @default(0) @db.Decimal(10, 2)
  sortOrder       Int                 @default(0)
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  modifierGroup   ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderModifiers  OrderItemModifier[]

  @@unique([modifierGroupId, name])
  @@index([modifierGroupId])
}

model Table {
  id           String      @id @default(uuid())
  restaurantId String
  areaId       String?
  name         String
  seats        Int         @default(2)
  status       TableStatus @default(AVAILABLE)
  x            Int?
  y            Int?
  width        Int?
  height       Int?
  shape        TableShape?
  rotation     Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  guestCount   Int         @default(0)
  notes        String?
  occupiedAt   DateTime?
  paidAt       DateTime?
  serverId     String?
  orders       Order[]
  TableArea    TableArea?  @relation(fields: [areaId], references: [id])
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  User         User?       @relation(fields: [serverId], references: [id])
  Reservation  Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([areaId])
  @@index([serverId])
  @@index([status])
}

model Customer {
  id           String     @id @default(uuid())
  restaurantId String
  fullName     String
  phone        String?
  email        String?
  notes        String?
  points       Int        @default(0)
  totalSpent   Decimal    @default(0) @db.Decimal(10, 2)
  visitCount   Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  GiftCard     GiftCard[]
  Reservation  Reservation[]
  WaitlistEntry WaitlistEntry[]

  @@index([restaurantId])
  @@index([restaurantId, email])
  @@index([restaurantId, phone])
}

model Order {
  id                String         @id @default(uuid())
  restaurantId      String
  userId            String
  orderNumber       Int
  status            OrderStatus    @default(OPEN)
  paymentMethod     PaymentMethod?
  subtotal          Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount         Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal        @default(0) @db.Decimal(10, 2)
  terminalReference String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  customerId        String?
  isOpen            Boolean        @default(true)
  orderType         OrderType      @default(DINE_IN)
  tableId           String?
  KitchenTicket     KitchenTicket?
  customer          Customer?      @relation(fields: [customerId], references: [id])
  restaurant        Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table             Table?         @relation(fields: [tableId], references: [id])
  user              User           @relation(fields: [userId], references: [id])
  items             OrderItem[]
  Payment           Payment[]

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId])
  @@index([userId])
  @@index([tableId])
  @@index([customerId])
}

model OrderItem {
  id         String              @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal             @db.Decimal(10, 2)
  totalPrice Decimal             @db.Decimal(10, 2)
  notes      String?
  createdAt  DateTime            @default(now())
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id])
  modifiers  OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id               String         @id @default(uuid())
  orderItemId      String
  modifierOptionId String
  nameSnapshot     String
  priceDelta       Decimal        @default(0) @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([modifierOptionId])
}

model Refund {
  id           String     @id @default(uuid())
  restaurantId String
  userId       String
  paymentId    String
  amount       Decimal    @db.Decimal(10, 2)
  reason       String
  reference    String?
  status       String     @default("PROCESSED")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Payment      Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  User         User       @relation(fields: [userId], references: [id])

  @@index([paymentId])
  @@index([restaurantId])
  @@index([status])
  @@index([userId])
}

model Shift {
  id           String      @id @default(uuid())
  restaurantId String
  userId       String
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openingCash  Decimal?    @db.Decimal(10, 2)
  closingCash  Decimal?    @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id])

  @@index([restaurantId])
  @@index([userId])
}

model KitchenTicket {
  id           String        @id
  restaurantId String
  orderId      String        @unique
  status       KitchenStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime
  Order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
}

model Payment {
  id                String        @id
  restaurantId      String
  userId            String
  orderId           String
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod
  terminalReference String?
  cardLast4         String?
  tipAmount         Decimal       @default(0) @db.Decimal(10, 2)
  cashTendered      Decimal?      @db.Decimal(10, 2)
  changeAmount      Decimal?      @db.Decimal(10, 2)
  reference         String?
  status            String        @default("COMPLETED")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  giftCardId        String?
  Order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Restaurant        Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  User              User          @relation(fields: [userId], references: [id])
  Refund            Refund[]
  GiftCard          GiftCard?     @relation(fields: [giftCardId], references: [id])

  @@index([orderId])
  @@index([restaurantId])
  @@index([status])
  @@index([userId])
  @@index([giftCardId])
}

model ProductModifierGroup {
  id              String        @id
  productId       String
  modifierGroupId String
  sortOrder       Int           @default(0)
  ModifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  Product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, modifierGroupId])
  @@index([modifierGroupId])
  @@index([productId])
}

model Ingredient {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  unit         String
  currentStock Decimal  @default(0) @db.Decimal(10, 2)
  minStock     Decimal  @default(0) @db.Decimal(10, 2)
  costPerUnit  Decimal  @default(0) @db.Decimal(10, 2)
  supplier     String?
  lastRestocked DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Restaurant   Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  RecipeItem   RecipeItem[]
  StockAdjustment StockAdjustment[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Recipe {
  id           String   @id @default(uuid())
  restaurantId String
  name         String
  productId    String
  totalCost    Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        RecipeItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([productId])
}

model RecipeItem {
  id           String   @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Decimal  @db.Decimal(10, 2)
  cost         Decimal  @default(0) @db.Decimal(10, 2)
  Recipe       Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  Ingredient   Ingredient  @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

model StockAdjustment {
  id            String   @id @default(uuid())
  restaurantId  String
  ingredientId  String
  adjustment    Decimal  @db.Decimal(10, 2)
  previousStock Decimal  @db.Decimal(10, 2)
  newStock      Decimal  @db.Decimal(10, 2)
  reason        String
  createdAt     DateTime @default(now())
  Restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  Ingredient    Ingredient  @relation(fields: [ingredientId], references: [id])

  @@index([restaurantId])
  @@index([ingredientId])
  @@index([createdAt])
}

model GiftCard {
  id            String   @id @default(uuid())
  restaurantId  String
  customerId    String?
  cardNumber    String   @unique
  balance       Decimal  @default(0) @db.Decimal(10, 2)
  initialAmount Decimal  @db.Decimal(10, 2)
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  Customer      Customer?  @relation(fields: [customerId], references: [id])
  Payment       Payment[]

  @@index([restaurantId])
  @@index([cardNumber])
  @@index([customerId])
}

model MarketingCampaign {
  id             String   @id @default(uuid())
  restaurantId   String
  name           String
  type           String
  status         String   @default("ACTIVE")
  startDate      DateTime
  endDate        DateTime
  targetAudience String
  budget         Decimal  @default(0) @db.Decimal(10, 2)
  message        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  Restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([status])
  @@index([startDate])
}

model Reservation {
  id            String   @id @default(uuid())
  restaurantId  String
  customerId    String?
  tableId       String?
  customerName  String
  customerPhone String?
  customerEmail String?
  guestCount    Int
  date          DateTime
  time          DateTime
  status        String   @default("CONFIRMED")
  notes         String?
  specialRequests String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  Restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  Customer      Customer?  @relation(fields: [customerId], references: [id])
  Table         Table?     @relation(fields: [tableId], references: [id])

  @@index([restaurantId])
  @@index([date])
  @@index([status])
  @@index([customerId])
  @@index([tableId])
}

model WaitlistEntry {
  id            String   @id @default(uuid())
  restaurantId  String
  customerId    String?
  customerName  String
  customerPhone String?
  guestCount    Int
  status        String   @default("WAITING")
  estimatedWait Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seatedAt      DateTime?
  Restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  Customer      Customer?  @relation(fields: [customerId], references: [id])

  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

model TableArea {
  id           String     @id
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Table        Table[]
  Restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

enum UserRole {
  PLATFORM_ADMIN
  OWNER
  MANAGER
  CASHIER
  KITCHEN
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum DeviceType {
  POS
  KDS
  MANAGER_TABLET
}

enum OrderStatus {
  OPEN
  PAID
  VOIDED
  COMPLETED
  MERGED
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
  GIFT_CARD
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DISABLED
  PAID
  NEEDS_ATTENTION
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum TableShape {
  RECTANGLE
  SQUARE
  ROUND
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  CALLED
  SEATED
  CANCELLED
}

model AuditLog {
  id            String   @id @default(uuid())
  restaurantId  String
  userId        String
  action        String
  entityType    String
  entityId      String?
  details       String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  Restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
