generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  CASHIER
  KITCHEN
}

enum OrderStatus {
  OPEN
  PAID
  VOIDED
  REFUNDED
  COMPLETED
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  MIXED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  PAID
  RESERVED
  NEEDS_ATTENTION
}

model Restaurant {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  address     String?
  phone       String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]
  categories  Category[]
  products    Product[]
  orders      Order[]
  shifts      Shift[]
  tables      Table[]
  customers   Customer[]
}

model User {
  id             String      @id @default(uuid())
  restaurantId   String
  fullName       String
  pin            String
  email          String?     @unique
  role           UserRole
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  shifts         Shift[]
  orders         Order[]
  changeLogs     OrderChangeLog[]

  @@index([restaurantId])
  @@index([restaurantId, role])
}

model Category {
  id             String      @id @default(uuid())
  restaurantId   String
  name           String
  sortOrder      Int         @default(0)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products       Product[]

  @@index([restaurantId])
  @@unique([restaurantId, name])
}

model Product {
  id             String         @id @default(uuid())
  restaurantId   String
  categoryId     String
  name           String
  description    String?
  price          Decimal        @db.Decimal(10, 2)
  sku            String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  modifierGroups ModifierGroup[]

  @@index([restaurantId])
  @@index([categoryId])
  @@unique([restaurantId, name])
}

model ModifierGroup {
  id          String          @id @default(uuid())
  productId   String
  name        String
  required    Boolean         @default(false)
  minChoices  Int             @default(0)
  maxChoices  Int             @default(1)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options     ModifierOption[]

  @@index([productId])
}

model ModifierOption {
  id               String            @id @default(uuid())
  modifierGroupId  String
  name             String
  price            Decimal           @default(0) @db.Decimal(10, 2)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  modifierGroup    ModifierGroup     @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderModifiers   OrderItemModifier[]

  @@index([modifierGroupId])
}

model Table {
  id            String      @id @default(uuid())
  restaurantId  String
  name          String
  seats         Int         @default(4)
  area          String      @default("Main Hall")
  shape         String      @default("circle")
  x             Int         @default(0)
  y             Int         @default(0)
  status        TableStatus @default(AVAILABLE)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([restaurantId])
  @@unique([restaurantId, name])
}

model Customer {
  id            String      @id @default(uuid())
  restaurantId  String
  name          String
  phone         String?
  email         String?
  loyaltyPoints Int         @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([restaurantId])
}

model Order {
  id                  String         @id @default(uuid())
  restaurantId        String
  userId              String
  customerId          String?
  tableId             String?
  orderNumber         Int
  orderType           OrderType      @default(DINE_IN)
  status              OrderStatus    @default(OPEN)
  kitchenStatus       KitchenStatus  @default(PENDING)
  paymentMethod       PaymentMethod?
  subtotal            Decimal        @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal        @default(0) @db.Decimal(10, 2)
  amountTendered      Decimal?       @db.Decimal(10, 2)
  changeDue           Decimal?       @db.Decimal(10, 2)
  tipAmount           Decimal?       @db.Decimal(10, 2)
  terminalReference   String?
  notes               String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  restaurant          Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer            Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  table               Table?         @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  refunds             Refund[]
  changeLogs          OrderChangeLog[]

  @@index([restaurantId])
  @@index([userId])
  @@index([tableId])
  @@unique([restaurantId, orderNumber])
}

model OrderItem {
  id             String              @id @default(uuid())
  orderId        String
  productId      String
  quantity       Int
  unitPrice      Decimal             @db.Decimal(10, 2)
  totalPrice     Decimal             @db.Decimal(10, 2)
  notes          String?
  course         String?
  preparedAt     DateTime?
  servedAt       DateTime?
  createdAt      DateTime            @default(now())

  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifiers      OrderItemModifier[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemModifier {
  id                 String         @id @default(uuid())
  orderItemId        String
  modifierOptionId   String
  nameSnapshot       String
  priceSnapshot      Decimal        @db.Decimal(10, 2)
  quantity           Int            @default(1)
  totalPrice         Decimal        @db.Decimal(10, 2)
  createdAt          DateTime       @default(now())

  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption     ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@index([modifierOptionId])
}

model Refund {
  id             String      @id @default(uuid())
  orderId        String
  amount         Decimal     @db.Decimal(10, 2)
  reason         String?
  paymentMethod  PaymentMethod?
  createdAt      DateTime    @default(now())

  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderChangeLog {
  id             String      @id @default(uuid())
  orderId        String
  userId         String
  action         String
  payload        Json?
  createdAt      DateTime    @default(now())

  order          Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model Shift {
  id             String       @id @default(uuid())
  restaurantId   String
  userId         String
  status         ShiftStatus  @default(OPEN)
  openedAt       DateTime     @default(now())
  closedAt       DateTime?
  openingCash    Decimal?     @db.Decimal(10, 2)
  closingCash    Decimal?     @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([restaurantId])
  @@index([userId])
  @@index([restaurantId, userId, status])
}
