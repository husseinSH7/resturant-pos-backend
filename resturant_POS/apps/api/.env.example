# Environment Configuration for API
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=production
PORT=4000

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Redis (Upstash)
REDIS_URL=redis://host:port

# JWT Secret - Change this to a strong random string
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Upstash Redis REST API (if using REST instead of direct connection)
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: CORS settings
CORS_ORIGIN=http://localhost:5173
