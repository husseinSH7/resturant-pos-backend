# Environment Configuration for API
# Copy this file to .env and fill in your actual values

# Node Environment
NODE_ENV=production
PORT=4000

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Redis (Upstash REST API - used by the app)
UPSTASH_REDIS_REST_URL=https://xxxxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Fallback Redis URL (if not using Upstash REST)
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# Frontend URL (for email links, password reset, etc.)
FRONTEND_URL=http://localhost:5173

# Base URL (for image URLs)
BASE_URL=http://localhost:4000

# CORS Allowed Origins (comma-separated)
# For local dev: http://localhost:5173,http://localhost:3000,http://localhost:19006,exp://*
# For production: https://your-dashboard-domain.com,https://your-mobile-app-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19006,exp://*,http://192.168.*:*

# Optional: Storage (for file uploads)
STORAGE_BUCKET=restaurant-pos-assets
